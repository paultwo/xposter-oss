{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-poster",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-poster",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "x-poster-media" }],
  "vars": {
    "ENVIRONMENT": "development",
    "POSTING_ENABLED": "false",
    "X_STANDARD_POST_LIMIT": "280",
    "X_PREMIUM_POST_LIMIT": "25000",
    "X_SHOW_MORE_AT": "280",
    "MAX_DAILY_POSTS": "20",
    "ALLOWED_APPROVER_EMAILS": "you@example.com",
    "ACCESS_TEAM_DOMAIN": "team.example.invalid",
    "ACCESS_AUD": "test-audience",
    "ACCESS_CERTS_URL": "http://127.0.0.1:9099/cdn-cgi/access/certs",
    "X_API_BASE": "http://127.0.0.1:9099",
    "X_AUTHORIZE_URL": "http://127.0.0.1:9099/i/oauth2/authorize",
    "INTAKE_ACCESS_CLIENT_ID": "x-poster-intake",
    "X_FETCH_TIMEOUT_MS": "400",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787"
  }
}
